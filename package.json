{
  "name": "aclint",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "turbo run dev panda:watch",
    "build": "turbo run build",
    "build:extension": "pnpm --filter aclint-extension build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.14",
    "typescript-eslint": "^8.0.0"
  }
}
