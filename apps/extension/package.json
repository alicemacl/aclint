{
  "name": "aclint-extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "build": "pnpm prepare && vite build && vite build --config vite.background.config.ts && cp manifest.json dist/",
    "dev": "pnpm prepare && vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aclint/lens": "workspace:*",
    "@accesslint/core": "^0.8.8",
    "@ark-ui/react": "^5.31.0",
    "axe-core": "^4.10.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.8.2",
    "@types/chrome": "^0.0.268",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "postcss": "^8.4.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
